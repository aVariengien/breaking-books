# LLM — Google Gemini (default model)
GOOGLE_API_KEY=

# LLM — Anthropic Claude (optional, for claude/* models via LiteLLM)
ANTHROPIC_API_KEY=

# LLM — OpenAI (optional, for openai/* models via LiteLLM)
# OPENAI_API_KEY=

# Image generation
RUNWARE_API_KEY=

# Font metadata generation (only needed when running scripts/generate_font_metadata.py)
GOOGLE_FONTS_API_KEY=

# Optional overrides
BB_MODEL=gemini/gemini-3.1-flash-lite-preview  # LiteLLM model string for the agent (default: Gemini 3.1 Flash-Lite)
BB_VISION_MODEL=gemini/gemini-2.0-flash        # Model used for vision QC checks
BB_IMAGE_GEN_MODEL=runware:101@1               # Runware model for card images
DISABLE_IMAGE_CACHE=false
