<!DOCTYPE html>
<!--
  default-classic.html.jinja2

  Quiet luxury aesthetic: editorial design with serif typography,
  image at top, refined typography hierarchy. Elegant and timeless.

  Variables: title, description, illustration, quote, section,
             visual_identity (with title_font, body_font, section_themes),
             get_image()

  All cards render at A6 size. Scaling for larger sizes happens at PDF merge stage.
-->
{% set title_size = '18pt' %}
{% set body_size = '8pt' %}
{% set quote_size = '7pt' %}
{% set margin = '5mm' %}
{% set image_height = '50%' %}

<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ title }}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=EB+Garamond:wght@400;600&display=swap');

    @page {
      size: {{ card_size | default('A6') }} portrait;
      margin: 0;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      height: 100%;
      font-feature-settings: "kern" 1, "liga" 1;
    }

    body {
      background: #ffffff;
      color: #1a1a1a;
      display: flex;
      flex-direction: column;
      font-family: {% if visual_identity.body_font %}'{{ visual_identity.body_font }}', {% endif %}'Lora', serif;
      font-size: {{ body_size }};
      line-height: 1.6;
    }

    .card {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* Image: top portion, understated */
    .image-section {
      height: {{ image_height }};
      position: relative;
      overflow: hidden;
      background: #f5f5f5;
      flex-shrink: 0;
    }

    .image-section img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .image-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #999;
      font-size: {{ quote_size }};
      padding: 3mm;
      text-align: center;
    }

    /* Content: text-heavy bottom */
    .content-section {
      flex: 1;
      padding: {{ margin }};
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: #ffffff;
      border-top: 2px solid {% if visual_identity.section_themes %}{{ visual_identity.section_themes[0].main_color }}{% else %}#ddd{% endif %};
    }

    .title {
      font-family: {% if visual_identity.title_font %}'{{ visual_identity.title_font }}', {% endif %}'EB Garamond', serif;
      font-size: {{ title_size }};
      font-weight: 600;
      line-height: 1.3;
      margin-bottom: {{ margin }};
      color: #1a1a1a;
      letter-spacing: -0.3px;
    }

    .description {
      font-size: {{ body_size }};
      line-height: 1.5;
      color: #2a2a2a;
      margin-bottom: {{ margin }};
      flex: 1;
      overflow: hidden;
    }

    .description b {
      font-weight: 600;
      color: #1a1a1a;
      {% if visual_identity.section_themes %}border-bottom: 1px solid {{ visual_identity.section_themes[0].accent_color }};{% endif %}
    }

    .quote-section {
      border-top: 1px solid #e0e0e0;
      padding-top: 3mm;
      margin-top: auto;
    }

    .quote {
      font-size: {{ quote_size }};
      font-style: italic;
      line-height: 1.5;
      color: #555;
      position: relative;
      padding-left: 4mm;
    }

    .quote::before {
      content: '"';
      position: absolute;
      left: 0;
      top: -2mm;
      font-size: {{ body_size }};
      font-style: normal;
      color: {% if visual_identity.section_themes %}{{ visual_identity.section_themes[0].main_color }}{% else %}#ccc{% endif %};
      opacity: 0.5;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="image-section">
      {% set image_base64 = get_image(illustration, 384, 256) %}
      {% if image_base64 %}
        <img src="data:image/png;base64,{{ image_base64 }}" alt="{{ illustration }}">
      {% else %}
        <div class="image-placeholder">{{ illustration }}</div>
      {% endif %}
    </div>

    <div class="content-section">
      <div>
        <h1 class="title">{{ title }}</h1>
        <div class="description">{{ description | safe }}</div>
      </div>

      <div class="quote-section">
        <p class="quote">{{ quote }}</p>
      </div>
    </div>
  </div>
</body>
</html>
