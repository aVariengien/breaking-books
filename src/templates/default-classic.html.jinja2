<!DOCTYPE html>
{#
  default-classic.html.jinja2
  Image top half · Title + description + quote bottom half.
  Quiet editorial. Colour band at top identifies section & type.
#}
{% from '_card_base.html.jinja2' import type_icon_class, tag_class, top_band_html, css_imports, shared_css %}
{% set theme = visual_identity.section_themes[0] %}
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    {{ css_imports(font_face_css) }}
    {{ shared_css(visual_identity, theme) }}

    .image-zone {
      flex: 0 0 52mm;
      overflow: hidden;
      background: {{ theme.dark_color }};
      clip-path: polygon(0 0, 100% 0, 100% 82%, 0% 100%);
    }
    .image-zone img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .image-placeholder {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      font-size: 6pt; color: rgba(255,255,255,0.4); padding: 4mm; text-align: center;
    }

    .content {
      flex: 1;
      padding: 4mm 5mm 4mm 5mm;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .title {
      font-size: 21pt;
      margin-bottom: 3mm;
    }

    .description {
      font-size: 8pt;
      line-height: 1.5;
      color: #111;
      overflow: hidden;
    }

    .quote-block {
      margin-top: 2.5mm;
      border-left: 2pt solid {{ theme.accent_color }};
      padding-left: 2.5mm;
    }
    .quote {
      font-size: 8pt;
      font-style: italic;
      color: #1a1a1a;
      line-height: 1.5;
    }
  </style>
</head>
<body>
  <div class="card{{ tag_class(tag) }}">
    {{ top_band_html(type, section) }}

    <div class="image-zone">
      {% set img = get_image(illustration, 640, 384) %}
      {% if img %}
        <img src="data:image/png;base64,{{ img }}" alt="">
      {% else %}
        <div class="image-placeholder">{{ illustration }}</div>
      {% endif %}
    </div>

    <div class="content">
      <h1 class="title">{{ title }}</h1>
      <div class="description">{{ description | safe }}</div>
      <div class="quote-block">
        <p class="quote">{{ quote }}</p>
      </div>
    </div>
  </div>
</body>
</html>
