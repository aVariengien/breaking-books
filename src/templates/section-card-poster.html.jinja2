<!DOCTYPE html>
{#
  section-card-poster.html.jinja2
  Top band. Large image zone. Title + description on white.
  Clean white card — black text, section identity from the band.
#}
{% from '_card_base.html.jinja2' import type_icon_class, tag_class, top_band_html, css_imports, shared_css %}
{% set theme = visual_identity.section_themes[0] %}
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    {{ css_imports(font_face_css, font_awesome_css) }}
    {{ shared_css(visual_identity, theme) }}

    .image-zone {
      flex: 0 0 62mm;
      overflow: hidden;
      background: {{ theme.main_color }};
    }
    .image-zone img {
      width: 100%; height: 100%;
      object-fit: cover; display: block;
    }
    .image-placeholder {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      font-size: 6pt; color: rgba(255,255,255,0.5);
      padding: 5mm; text-align: center;
    }

    .content {
      flex: 1;
      padding: 4mm 5mm 5mm;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .title {
      font-size: 23pt;
      color: #111;
      line-height: 1.1;
      margin-bottom: 3mm;
    }

    .description {
      font-size: 7.5pt;
      color: #111;
      line-height: 1.55;
      flex: 1;
      overflow: hidden;
    }
  </style>
</head>
<body>
  <div class="card{{ tag_class(tag) }}">
    {{ top_band_html(type, section) }}

    <div class="image-zone">
      {% set img = get_image(illustration, 512, 512) %}
      {% if img %}
        <img src="data:image/png;base64,{{ img }}" alt="">
      {% else %}
        <div class="image-placeholder">{{ illustration }}</div>
      {% endif %}
    </div>

    <div class="content">
      <h1 class="title">{{ title }}</h1>
      <p class="description">{{ description }}</p>
    </div>
  </div>
</body>
</html>
