<!DOCTYPE html>
<!--
  concept-image-right — text column on the left, image column on the right.
  Variables: title, book_quotes, image_description, image_base64,
             card_size (A5|A6), language
-->
{% if card_size == 'A5' %}
  {% set title_size = '24pt' %}
  {% set quote_size = '9pt' %}
  {% set quote_mark_size = '13pt' %}
{% else %}
  {% set title_size = '16pt' %}
  {% set quote_size = '7pt' %}
  {% set quote_mark_size = '10pt' %}
{% endif %}
<html lang="{{ language | default('en') }}">
<head>
  <meta charset="UTF-8">
  <title>{{ title }}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Source+Sans+Pro:wght@400;600&display=swap');

    @page {
      size: {{ card_size | default('A6') }} landscape;
      margin: 0;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      height: 100%;
    }

    body {
      background: #fff;
      color: #1a1a1a;
    }

    .card {
      width: 100%;
      height: 100%;
      display: grid;
      grid-template-columns: 3fr 2fr;
    }

    .text-col {
      display: flex;
      flex-direction: column;
      padding: 4mm;
      border-right: 2pt solid #222;
    }

    .title {
      font-family: 'Playfair Display', serif;
      font-size: {{ title_size }};
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 3mm;
    }

    .quotes {
      font-family: 'Source Sans Pro', sans-serif;
      font-size: {{ quote_size }};
      line-height: 1.4;
      flex: 1;
      overflow: hidden;
    }

    .quotes ul {
      list-style: none;
      padding: 0;
    }

    .quotes li {
      margin-bottom: 2mm;
      padding-left: 5mm;
      position: relative;
    }

    .quotes li::before {
      content: "\201C";
      position: absolute;
      left: 0;
      top: -1px;
      font-size: {{ quote_mark_size }};
      color: #888;
      font-family: 'Playfair Display', serif;
    }

    .image-col {
      overflow: hidden;
      position: relative;
    }

    .image-col img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .image-placeholder {
      width: 100%;
      height: 100%;
      background: #efefef;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3mm;
      color: #aaa;
      font-family: 'Source Sans Pro', sans-serif;
      font-size: {{ quote_size }};
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="text-col">
      <h1 class="title">{{ title }}</h1>
      <div class="quotes">
        {% if book_quotes %}
        <ul>
          {% for quote in book_quotes %}
          <li>{{ quote }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
    </div>
    <div class="image-col">
      {% if image_base64 %}
      <img src="data:image/png;base64,{{ image_base64 }}" alt="{{ image_description }}">
      {% else %}
      <div class="image-placeholder">{{ image_description }}</div>
      {% endif %}
    </div>
  </div>
</body>
</html>
