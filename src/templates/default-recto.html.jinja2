<!DOCTYPE html>
<!--
  default-recto.html.jinja2

  Dark, atmospheric card. The illustration spans the full width at the top
  in a precise rectangle. A thin accent-color rule cleanly separates it
  from the dark body below. The title is rendered in main_color against
  the deep background; description in near-white; quote muted at the bottom
  with a dash in accent color.

  Aesthetic: cinematographer's storyboard note, brooding, precise, intimate.

  Template variables (all optional except title/description/illustration/quote/section):
    title, description, illustration, quote, section, tag
    main_color, accent_color, dark_color, title_font, body_font
    card_size ('A6' default | 'A5'), language, get_image()
-->
{% if card_size == 'A5' %}
  {% set title_size = '28pt' %}
  {% set body_size = '10pt' %}
  {% set quote_size = '8.5pt' %}
  {% set label_size = '6pt' %}
  {% set img_height = '44%' %}
  {% set pad = '7mm' %}
  {% set rule_h = '2.5pt' %}
{% else %}
  {% set title_size = '17pt' %}
  {% set body_size = '7.5pt' %}
  {% set quote_size = '6.5pt' %}
  {% set label_size = '5pt' %}
  {% set img_height = '41%' %}
  {% set pad = '5mm' %}
  {% set rule_h = '2pt' %}
{% endif %}

<html lang="{{ language | default('en') }}">
<head>
  <meta charset="UTF-8">
  <title>{{ title }}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital@0;1&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,600;1,300&display=swap');

    @page {
      size: {{ card_size | default('A6') }} portrait;
      margin: 0;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { width: 100%; height: 100%; }

    body {
      background: {% if dark_color and dark_color != '#000000' %}{{ dark_color }}{% else %}#151515{% endif %};
      color: #e4e0d8;
      font-family: {% if body_font %}'{{ body_font }}', {% endif %}'IBM Plex Sans', sans-serif;
      font-size: {{ body_size }};
    }

    .card {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* ── Image strip ── */
    .image-strip {
      height: {{ img_height }};
      flex-shrink: 0;
      overflow: hidden;
      background: #2a2a2a;
      position: relative;
    }

    .image-strip img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Section badge: top-right of the image */
    .section-badge {
      position: absolute;
      top: 3mm;
      right: 3mm;
      background: {% if main_color %}{{ main_color }}{% else %}#3d7ab5{% endif %};
      color: #ffffff;
      font-family: 'Space Mono', monospace;
      font-size: {{ label_size }};
      padding: 1mm 2.5mm;
      letter-spacing: 0.5pt;
      line-height: 1;
    }

    /* ── Accent separator ── */
    .separator {
      height: {{ rule_h }};
      flex-shrink: 0;
      background: {% if accent_color %}{{ accent_color }}{% else %}#d45f2a{% endif %};
    }

    /* ── Text content ── */
    .content {
      flex: 1;
      padding: {{ pad }};
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .title {
      font-family: {% if title_font %}'{{ title_font }}', {% endif %}'Space Mono', monospace;
      font-size: {{ title_size }};
      font-weight: 400;
      line-height: 1.12;
      color: {% if main_color %}{{ main_color }}{% else %}#7ab0e0{% endif %};
      letter-spacing: -0.3pt;
      margin-bottom: 3mm;
    }

    .description {
      font-size: {{ body_size }};
      line-height: 1.62;
      color: rgba(228, 224, 216, 0.86);
      font-weight: 300;
      flex: 1;
      overflow: hidden;
    }

    .description b {
      font-weight: 600;
      color: {% if accent_color %}{{ accent_color }}{% else %}#d45f2a{% endif %};
    }

    /* ── Quote ── */
    .quote-area {
      margin-top: auto;
      padding-top: 3mm;
      flex-shrink: 0;
    }

    .quote-rule {
      height: 0.5pt;
      background: rgba(228, 224, 216, 0.18);
      margin-bottom: 2.5mm;
    }

    .quote {
      font-family: {% if body_font %}'{{ body_font }}', {% endif %}'IBM Plex Sans', sans-serif;
      font-size: {{ quote_size }};
      font-style: italic;
      font-weight: 300;
      color: rgba(228, 224, 216, 0.48);
      line-height: 1.48;
    }

    .quote::before {
      content: '— ';
      font-style: normal;
      font-weight: 400;
      color: {% if accent_color %}{{ accent_color }}{% else %}#d45f2a{% endif %};
    }
  </style>
</head>
<body>
  <div class="card">

    <div class="image-strip">
      {% set image_base64 = get_image(illustration, 384, 256) %}
      {% if image_base64 %}
        <img src="data:image/png;base64,{{ image_base64 }}" alt="">
      {% endif %}
      <div class="section-badge">§{{ "%02d" | format(section + 1) }}</div>
    </div>

    <div class="separator"></div>

    <div class="content">
      <h1 class="title">{{ title }}</h1>
      <div class="description">{{ description | safe }}</div>
      <div class="quote-area">
        <div class="quote-rule"></div>
        <p class="quote">{{ quote }}</p>
      </div>
    </div>

  </div>
</body>
</html>
