<!DOCTYPE html>
{#
  default-billboard.html.jinja2
  Full-bleed image (top 55%) with a dark gradient.
  Title sits large below on a clean white ground. Quote at the bottom.
  Cinematic, punchy.
#}
{% from '_card_base.html.jinja2' import type_icon_class, tag_class, top_band_html, css_imports, shared_css %}
{% set theme = visual_identity.section_themes[0] %}
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    {{ css_imports(visual_identity) }}
    {{ shared_css(visual_identity, theme) }}

    .image-zone {
      flex: 0 0 62mm;
      position: relative;
      overflow: hidden;
      background: {{ theme.dark_color }};
    }
    .image-zone img {
      width: 100%; height: 100%;
      object-fit: cover; display: block;
    }
    .image-placeholder {
      width: 100%; height: 100%;
      display: flex; align-items: flex-end;
      font-size: 6pt; color: rgba(255,255,255,0.4);
      padding: 4mm; text-align: center;
    }

    .content {
      flex: 1;
      padding: 3mm 5mm 4mm 5mm;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .title {
      font-size: 22pt;
      margin-bottom: 3mm;
      line-height: 1.1;
    }

    .description {
      font-size: 7.5pt;
      line-height: 1.5;
      overflow: hidden;
    }

    .quote-block {
      margin-top: 2.5mm;
      border-left: 2pt solid {{ theme.accent_color }};
      padding-left: 2.5mm;
    }
    .quote {
      font-size: 7.5pt;
      font-style: italic;
      color: #1a1a1a;
      line-height: 1.5;
    }
  </style>
</head>
<body>
  <div class="card{{ tag_class(tag) }}">
    {{ top_band_html(type, section) }}

    <div class="image-zone">
      {% set img = get_image(illustration, 640, 448) %}
      {% if img %}
        <img src="data:image/png;base64,{{ img }}" alt="">
      {% else %}
        <div class="image-placeholder">{{ illustration }}</div>
      {% endif %}
    </div>

    <div class="content">
      <h1 class="title">{{ title }}</h1>
      <div class="description">{{ description | safe }}</div>
      <div class="quote-block">
        <p class="quote">{{ quote }}</p>
      </div>
    </div>
  </div>
</body>
</html>
