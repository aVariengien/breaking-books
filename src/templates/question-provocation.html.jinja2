<!DOCTYPE html>
{#
  question-provocation.html.jinja2
  Texture fills the card as a background wash.
  The question centred, large and bold. Confrontational. Nothing else.
#}
{% from '_card_base.html.jinja2' import type_icon_class, tag_class, top_band_html, css_imports, shared_css %}
{% set theme = visual_identity.section_themes[0] %}
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    {{ css_imports(font_face_css, font_awesome_css) }}
    {{ shared_css(visual_identity, theme) }}

    .card { position: relative; }

    /* Texture as background image */
    .bg-texture {
      position: absolute;
      top: 0; right: 0; bottom: 0; left: 0;
      background-size: cover;
      background-position: center;
      opacity: 0.18;
      z-index: 0;
    }

    /* Main content above texture */
    .card-content {
      position: relative;
      z-index: 2;
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 6mm 7mm;
      text-align: center;
    }

    .question-text {
      font-family: {% if visual_identity.title_font %}'{{ visual_identity.title_font }}', {% endif %}Georgia, serif;
      font-size: 21pt;
      font-weight: 700;
      color: #111;
      line-height: 1.25;
      position: relative;
      z-index: 3;
    }
  </style>
</head>
<body>
  <div class="card{{ tag_class(tag) }}">
    {{ top_band_html(type, section) }}

    {% set tex = get_image(texture, 512, 768) %}
    {% if tex %}
      <div class="bg-texture" style="background-image: url('data:image/png;base64,{{ tex }}');"></div>
    {% endif %}

    <div class="card-content">
      <p class="question-text">{{ question }}</p>
    </div>
  </div>
</body>
</html>
