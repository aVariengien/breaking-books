<!DOCTYPE html>
{#
  example-card-dispatch.html.jinja2
  Left image column (40%) · Right: "EXAMPLE" tag + title + description + quote.
  Newspaper dispatch feel — the image is the scene, the text is the story.
#}
{% from '_card_base.html.jinja2' import type_icon_class, tag_class, top_band_html, css_imports, shared_css %}
{% set theme = visual_identity.section_themes[0] %}
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    {{ css_imports(font_face_css, font_awesome_css) }}
    {{ shared_css(visual_identity, theme) }}

    /* Absolute-positioned columns — more reliable than row-flex in WeasyPrint */
    .body {
      position: relative;
      flex: 1;
      overflow: hidden;
    }

    .image-col {
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 39%;
      overflow: hidden;
      background: {{ theme.dark_color }};
    }
    .image-col img {
      width: 100%; height: 100%;
      object-fit: cover; display: block;
    }
    .image-placeholder {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      font-size: 5.5pt; color: rgba(255,255,255,0.4);
      padding: 3mm; text-align: center;
    }

    .text-col {
      position: absolute;
      left: 39%; right: 0; top: 0; bottom: 0;
      padding: 4mm 5mm 4mm 4mm;
      overflow: hidden;
    }

    .type-tag {
      font-size: 5.5pt;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: {{ theme.accent_color }};
      margin-bottom: 2mm;
    }

    .title {
      font-size: 18pt;
      margin-bottom: 2.5mm;
      line-height: 1.15;
    }

    .description {
      font-size: 7.5pt;
      line-height: 1.5;
      flex: 1;
      overflow: hidden;
    }

    .quote-block {
      margin-top: 3mm;
      border-left: 2pt solid {{ theme.accent_color }};
      padding-left: 2.5mm;
    }
    .quote {
      font-size: 7.5pt;
      font-style: italic;
      color: #111;
      line-height: 1.5;
    }
  </style>
</head>
<body>
  <div class="card{{ tag_class(tag) }}">
    {{ top_band_html(type, section) }}

    <div class="body">
      <div class="image-col">
        {% set img = get_image(illustration, 320, 640) %}
        {% if img %}
          <img src="data:image/png;base64,{{ img }}" alt="">
        {% else %}
          <div class="image-placeholder">{{ illustration }}</div>
        {% endif %}
      </div>

      <div class="text-col">
        <p class="type-tag">Example</p>
        <h1 class="title">{{ title }}</h1>
        <div class="description">{{ description | safe }}</div>
        <div class="quote-block">
          <p class="quote">{{ quote }}</p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
