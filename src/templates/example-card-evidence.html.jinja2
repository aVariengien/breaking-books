<!DOCTYPE html>
{#
  example-card-evidence.html.jinja2
  Image top (55%) with an accent-color caption bar overlaid at its bottom.
  Title below large. Description. Quote with left rule.
  The image is evidence; the text is the verdict.
#}
{% from '_card_base.html.jinja2' import type_icon_class, tag_class, top_band_html, css_imports, shared_css %}
{% set theme = visual_identity.section_themes[0] %}
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    {{ css_imports(visual_identity) }}
    {{ shared_css(visual_identity, theme) }}

    .image-zone {
      flex: 0 0 56mm;
      position: relative;
      overflow: hidden;
      background: {{ theme.dark_color }};
    }
    .image-zone img {
      width: 100%; height: 100%;
      object-fit: cover; display: block;
    }
    .image-placeholder {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      font-size: 6pt; color: rgba(255,255,255,0.4);
      padding: 4mm; text-align: center;
    }

    /* "EXAMPLE" bar sits at the bottom of the image zone */
    .caption-bar {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 7mm;
      background: {{ theme.accent_color }};
      display: flex;
      align-items: center;
      padding: 0 5mm;
    }
    .caption-bar span {
      font-size: 5.5pt;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: {{ theme.main_color }};
      font-family: {% if visual_identity.title_font %}'{{ visual_identity.title_font }}', {% endif %}sans-serif;
    }

    .content {
      flex: 1;
      padding: 3.5mm 5mm 4mm;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .title {
      font-size: 20pt;
      margin-bottom: 2.5mm;
      line-height: 1.15;
    }

    .description {
      font-size: 7.5pt;
      line-height: 1.5;
      overflow: hidden;
    }

    .quote-block {
      margin-top: 3mm;
      border-left: 2pt solid {{ theme.accent_color }};
      padding-left: 2.5mm;
    }
    .quote {
      font-size: 7.5pt;
      font-style: italic;
      color: #111;
      line-height: 1.5;
    }
  </style>
</head>
<body>
  <div class="card{{ tag_class(tag) }}">
    {{ top_band_html(type, section) }}

    <div class="image-zone">
      {% set img = get_image(illustration, 640, 384) %}
      {% if img %}
        <img src="data:image/png;base64,{{ img }}" alt="">
      {% else %}
        <div class="image-placeholder">{{ illustration }}</div>
      {% endif %}
      <div class="caption-bar"><span>Example</span></div>
    </div>

    <div class="content">
      <h1 class="title">{{ title }}</h1>
      <div class="description">{{ description | safe }}</div>
      <div class="quote-block">
        <p class="quote">{{ quote }}</p>
      </div>
    </div>
  </div>
</body>
</html>
