<!DOCTYPE html>
{#
  axis-spectrum.html.jinja2
  Top band. Title. A horizontal arrow spanning the full card width.
  Low label left · High label right. Description below.
  The arrow is the card — players place other cards along it.
#}
{% from '_card_base.html.jinja2' import type_icon_class, tag_class, top_band_html, css_imports, shared_css %}
{% set theme = visual_identity.section_themes[0] %}
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    {{ css_imports(font_face_css, font_awesome_css) }}
    {{ shared_css(visual_identity, theme) }}

    .content {
      flex: 1;
      padding: 5mm 5mm 5mm;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .card-type {
      font-size: 6pt;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: {{ theme.accent_color }};
      margin-bottom: 2mm;
      font-family: {% if visual_identity.title_font %}'{{ visual_identity.title_font }}', {% endif %}sans-serif;
    }

    .title {
      font-size: 20pt;
      margin-bottom: 5mm;
      line-height: 1.2;
    }

    /* Arrow track: line + arrowhead */
    .arrow-row {
      display: flex;
      align-items: center;
      flex-shrink: 0;
      margin: 0 1mm;
    }
    .arrow-line {
      flex: 1;
      height: 2pt;
      background: {{ theme.accent_color }};
    }
    .arrow-head {
      width: 0;
      height: 0;
      border-top: 5pt solid transparent;
      border-bottom: 5pt solid transparent;
      border-left: 9pt solid {{ theme.accent_color }};
      flex-shrink: 0;
    }

    /* End labels sit below the arrow */
    .axis-labels {
      display: flex;
      justify-content: space-between;
      margin-top: 2.5mm;
      margin-bottom: 5mm;
    }
    .axis-label {
      font-size: 6.5pt;
      font-weight: 600;
      line-height: 1.3;
      max-width: 44%;
    }
    .axis-label.low {
      text-align: left;
      color: #111;
      opacity: 0.6;
    }
    .axis-label.high {
      text-align: right;
      color: #111;
      font-weight: 700;
    }

    .rule {
      height: 1pt;
      background: {{ theme.dark_color }};
      opacity: 0.15;
      margin-bottom: 4mm;
    }

    .description {
      font-size: 7.5pt;
      line-height: 1.6;
      flex: 1;
      overflow: hidden;
    }
  </style>
</head>
<body>
  <div class="card{{ tag_class(tag) }}">
    {{ top_band_html(type, section) }}

    <div class="content">
      <p class="card-type">Card Axis</p>
      <h1 class="title">{{ title }}</h1>

      <div class="arrow-row">
        <div class="arrow-line"></div>
        <div class="arrow-head"></div>
      </div>

      <div class="axis-labels">
        <span class="axis-label low">{{ low_end }}</span>
        <span class="axis-label high">{{ high_end }}</span>
      </div>

      <div class="rule"></div>

      <div class="description">{{ description | safe }}</div>
    </div>
  </div>
</body>
</html>
