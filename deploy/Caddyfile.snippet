
breaking-books.alexandrevariengien.com {
	encode zstd gzip
	# Cap uploads; Streamlit enforces its own 200MB limit on top of this.
	request_body {
		max_size 200MB
	}
	# No transport timeouts here on purpose: Caddy defaults to no read/write
	# timeout, which is what long agent runs need. Setting one would only cut
	# runs short. Streamlit's websocket (/_stcore/stream) proxies fine as-is —
	# browsers do the wss:// handshake over HTTP/1.1.
	reverse_proxy 127.0.0.1:9201
}
